# Copy this file to .env and fill in your own values:  cp .env.example .env
# Never commit the real .env file.

# --- Chroma Cloud (https://trychroma.com) — notebooks [1], [2]
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=ck-your-chroma-api-key
CHROMA_TENANT=00000000-0000-0000-0000-000000000000
CHROMA_DATABASE=your-database-name

# --- Google Gemini (https://aistudio.google.com/apikey) — notebooks [3], [4]
GEMINI_API_KEY=your-gemini-api-key

# --- Telegram bot from @BotFather — notebook [4]
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
TELEGRAM_ALLOWED_USERS=

# --- Optional: MCP server URL. If empty, it is looked up from the deployed Modal app.
# MCP_URL=https://<your-modal-workspace>--workshop-documents-mcp-serve.modal.run/mcp
